web/node_modules/
web/dist/
web/coverage/

# The decider sidecar is its own npm package (see decider/).
decider/node_modules/

# Playwright's per-run output: reports, traces and failure context.
web/test-results/
web/playwright-report/
*.local
.DS_Store

# Design-tool prototype exports. Their mock content is personal, so they stay local.
design/prototypes/

# bv (beads viewer) local config and caches
.bv/

# Local-only notes, plans and exports
local/
docs/backend-plan.md
docs/reviews/

# The built frontend is copied here by bin/generate so Go's embed can reach it.
# Only the placeholder is committed, so the package compiles in a fresh clone.
server/internal/webassets/dist/*
!server/internal/webassets/dist/placeholder.html
# bin/generate swaps the new build in through these; a killed run can leave one.
server/internal/webassets/dist.new/
server/internal/webassets/dist.old/

# The built binary.
server/norte
