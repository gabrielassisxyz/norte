#!/usr/bin/env bash
# The gate. Everything that must be true before a commit lands, in one command.
#
#   bin/ci                 run every check
#   bin/ci <name>...       run only the named checks
#   bin/ci --list          list the check names
#
# This is exactly what .github/workflows/ci.yml runs, so a green local run and a
# green CI run mean the same thing. A failing check prints `FAILED: <name>`;
# docs/tools/ci-checks.md maps every name to the single command that reruns it
# alone, which is how a red run is investigated without rerunning the gate.
#
# Later beads add their checks here.
set -uo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo" || exit 1

# sqlc and generate judge the generated code as committed, so they run before any
# check that regenerates the tree: contracts-test runs the real bin/generate, and
# placed earlier it rewrote stale generated files before the freshness snapshot
# was taken, letting a contract edited without regeneration pass the gate.
checks=(pins pins-test contracts sqlc generate contracts-test gofmt go-vet go-build go-test go-test-race web-test extension-test extension-e2e extension-firefox web-e2e-csp web-e2e-phone web-e2e-library-search-sort web-e2e-shell-boot)

# A temporary NORTE_DATA keeps the suite off the real data directory, so a test
# that writes cannot touch whatever is installed on the machine running the gate.
scratch=""
scratch_dir() {
    if [ -z "$scratch" ]; then
        scratch="$(mktemp -d -p "${TMPDIR:-/tmp}" norte-ci.XXXXXX)"
    fi
    printf '%s' "$scratch"
}
cleanup() { [ -n "$scratch" ] && rm -rf "$scratch"; }
trap cleanup EXIT

check_pins() {
    bin/check-pins
}

check_pins_test() {
    bash scripts/pins-test.sh
}

# The two rules about api/openapi/<module>.yaml that no generator checks: a file
# only declares paths under its own module's prefix, and every object schema
# names every field it accepts.
check_contracts() {
    bin/check-contracts
}

check_contracts_test() {
    bash scripts/contracts-test.sh
}

# gofmt reports nothing and exits 0 on unformatted files, so the output is the
# verdict and the exit code is not.
check_gofmt() {
    local unformatted
    unformatted="$(cd server && gofmt -l .)"
    if [ -n "$unformatted" ]; then
        printf 'these files are not gofmt-clean:\n%s\n' "$unformatted" >&2
        return 1
    fi
}

check_go_vet() {
    (cd server && go vet ./...)
}

# `sqlc diff` regenerates in memory and compares, so it writes nothing and the
# verdict is whether the committed internal/*/db still matches the queries it
# came from. Editing a generated file, or changing a query without regenerating,
# both fail here rather than at the next unrelated `sqlc generate`. The version
# is pinned by the tool directive in server/go.mod, so no two machines can
# disagree about what the output should be. The first run compiles sqlc, which
# takes about half a minute; later runs come from the build cache.
check_sqlc() {
    (cd server && go tool sqlc diff)
}

# Generated code is committed, so a contract or a query can be edited and the
# regeneration forgotten. check-generated snapshots the generated paths, runs
# bin/generate, and fails naming whatever the run changed -- so this one check
# both produces the frontend the binary embeds and proves the committed
# generated code is what the generators currently write. It also covers
# `npm run build`, which is why there is no separate check for that: repeating
# the frontend build would double the gate's slowest step.
check_generate() {
    bin/check-generated
}

check_go_build() {
    (cd server && go build -o norte ./cmd/norte)
}

check_go_test() {
    (cd server && NORTE_DATA="$(scratch_dir)/data" go test ./...)
}

# Two worker loops against one database must never run one job twice. This
# runs under -race because the claim is concurrent by design: the single
# writer serialises the UPDATE, and the race detector proves the test's own
# bookkeeping does not hide a double run.
check_go_test_race() {
    (cd server && go test -race ./internal/core -run TestWorkersDoNotDoubleClaim -count=1)
}

check_web_test() {
    (cd web && npm test)
}

# --ignore-scripts skips Playwright's browser download, which the e2e check
# decides for itself: a machine with a system Chromium needs no second copy.
ensure_extension_dependencies() {
    if [ ! -d extension/node_modules ]; then
        (cd extension && npm ci --ignore-scripts) || return
    fi
}

check_extension_test() {
    ensure_extension_dependencies || return
    (cd extension && npm test && npm run build)
}

# The frontend build is not repeated here: the gate's `generate` check has
# already written the reader into server/internal/webassets/dist, and running
# vite twice would double the gate's slowest step. A standalone run against a
# changed frontend needs `bin/generate web` first, otherwise the reader
# assertion exercises whatever is embedded.
check_extension_e2e() {
    ensure_extension_dependencies || return
    (cd server && go build -o norte ./cmd/norte) || return
    if [ -z "${CHROMIUM_BIN:-}" ] && command -v chromium >/dev/null; then
        export CHROMIUM_BIN
        CHROMIUM_BIN="$(command -v chromium)"
    elif [ -z "${CHROMIUM_BIN:-}" ]; then
        export PLAYWRIGHT_BROWSERS_PATH="$repo/extension/artifacts/browsers"
        (cd extension && npx playwright install chromium) || return
    fi
    (cd extension && npm run test:e2e)
}

check_extension_firefox() {
    ensure_extension_dependencies || return
    (cd extension && npm run test:firefox)
}

# The two browser suites. They drive the binary go-build produced, serving the
# frontend generate built, so both have to have run first -- which is why they
# are last in the list.
#
# The browser is fetched here rather than by a step in the workflow, because
# .github/workflows/ci.yml runs exactly `bin/ci` and that is worth keeping: a
# green local run and a green CI run then mean the same thing. The download is
# idempotent and costs nothing once the version pinned by web/package-lock.json
# is on the machine.
norte_playwright_browser() {
    (cd web && npx --no-install playwright install chromium)
}

check_web_e2e_csp() {
    norte_playwright_browser || return 1
    (cd web && npx --no-install playwright test e2e/csp.spec.ts)
}

check_web_e2e_phone() {
    norte_playwright_browser || return 1
    (cd web && npx --no-install playwright test e2e/phone-walk.spec.ts)
}

check_web_e2e_library_search_sort() {
    norte_playwright_browser || return 1
    (cd web && npx --no-install playwright test e2e/library-search-sort.spec.ts)
}

check_web_e2e_shell_boot() {
    norte_playwright_browser || return 1
    (cd web && npx --no-install playwright test e2e/shell-boot.spec.ts)
}

# run_check <name> — run one check, announce the verdict, return its status.
run_check() {
    local name="$1"
    local function_name="check_${name//-/_}"
    if ! declare -F "$function_name" > /dev/null; then
        echo "ci: no such check: $name" >&2
        return 1
    fi
    printf '\n=== %s ===\n' "$name"
    if "$function_name"; then
        printf 'ok: %s\n' "$name"
        return 0
    fi
    printf 'FAILED: %s\n' "$name" >&2
    return 1
}

case "${1:-}" in
    --list)
        printf '%s\n' "${checks[@]}"
        exit 0
        ;;
    -h | --help)
        sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
esac

requested=("${checks[@]}")
if [ "$#" -gt 0 ]; then
    requested=("$@")
fi

# Every check runs even after one fails, because a single red run that names all
# the broken checks is worth more than the first one found.
failed=()
for name in "${requested[@]}"; do
    run_check "$name" || failed+=("$name")
done

printf '\n'
if [ "${#failed[@]}" -gt 0 ]; then
    printf 'FAILED: %s\n' "${failed[@]}" >&2
    printf 'ci: %d of %d checks failed; docs/tools/ci-checks.md has the command to rerun each one\n' \
        "${#failed[@]}" "${#requested[@]}" >&2
    exit 1
fi
printf 'ci: all %d checks passed\n' "${#requested[@]}"
